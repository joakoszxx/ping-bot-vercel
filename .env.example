# Discord Developer Portal → General Information → Public Key
DISCORD_PUBLIC_KEY=

# Private server-side variables. Never prefix these with NEXT_PUBLIC_.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# Public site origin and a random secret used to sign short-lived OAuth state cookies.
APP_BASE_URL=https://templeague.vercel.app
OAUTH_COOKIE_SECRET=

# Roblox Creator Dashboard OAuth app credentials.
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# Optional: a server ID registers /ping there during deployment (fast to appear).
# Leave empty to register globally.
DISCORD_GUILD_ID=

# Discord role awarded after Roblox OAuth succeeds. Bot needs Manage Roles and its top role above this role.
DISCORD_VERIFIED_ROLE_ID=
